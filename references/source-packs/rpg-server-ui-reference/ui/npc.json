{
  "namespace": "npc",

  "main_panel": {
    "type": "panel",
    "size": ["100%", "100%"],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "dimmer_background": {
          "type": "image",
          "texture": "textures/ui/Black",
          "size": ["100%", "100%"],
          "alpha": 0.5,
          "layer": 1
        }
      },
      {
        "dialog_box": {
          "type": "panel",
          "size": [350, 220],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 2,
          "controls": [
            {
              "background": {
                "type": "image",
                "texture": "textures/ui/dialog_background_opaque",
                "size": ["100%", "100%"],
                "layer": 1,
                "alpha": 0.95
              }
            },
            {
              "content_panel": {
                "type": "panel",
                "size": [330, 200],
                "offset": [0, 0],
                "anchor_from": "center",
                "anchor_to": "center",
                "layer": 3,
                "controls": [
                  {
                    "title": {
                      "type": "label",
                      "text": "#title",
                      "font_type": "MinecraftTen",
                      "font_size": "extra_large",
                      "color": [1.0, 0.84, 0.0],
                      "shadow": true,
                      "size": ["100%", 20],
                      "offset": [0, -85],
                      "anchor_from": "top_center",
                      "anchor_to": "top_center",
                      "layer": 4,
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_property_name": "(#title_text - 'menu.npc')",
                          "target_property_name": "#title"
                        }
                      ]
                    }
                  },
                  {
                    "body_panel": {
                      "type": "panel",
                      "size": [300, 90],
                      "offset": [0, -30],
                      "anchor_from": "top_center",
                      "anchor_to": "top_center",
                      "layer": 4,
                      "controls": [
                        {
                          "body": {
                            "type": "label",
                            "text": "#form",
                            "font_type": "MinecraftTen",
                            "font_scale_factor": 1.1,
                            "color": "white",
                            "shadow": true,
                            "size": ["100%", "100%"],
                            "anchor_from": "top_left",
                            "anchor_to": "top_left",
                            "text_alignment": "left",
                            "layer": 5,
                            "bindings": [
                              {
                                "binding_type": "view",
                                "source_property_name": "(#form_text - 'menu.invisible')",
                                "target_property_name": "#form"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "button_container": {
                      "type": "stack_panel",
                      "orientation": "horizontal",
                      "size": ["100%", 30],
                      "offset": [0, 60],
                      "anchor_from": "bottom_center",
                      "anchor_to": "bottom_center",
                      "layer": 4,
                      "collection_name": "form_buttons",
                      "controls": [
                        {
                          "b0@npc.npc_button": {
                            "collection_index": 0,
                            "$slot_size": [150, 30],
                            "$button_size": [140, 22],
                            "$offset": [5, 0]
                          }
                        },
                        {
                          "b1@npc.npc_button": {
                            "collection_index": 1,
                            "$slot_size": [150, 30],
                            "$button_size": [140, 22],
                            "$offset": [5, 0]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_property_name": "(not (#title_text - 'menu.npc' = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  "npc_button": {
    "$button_size|default": [140, 22],
    "$slot_size|default": [150, 30],
    "$offset|default": [5, 0],
    "$alpha|default": 1.0,

    "type": "panel",
    "size": "$slot_size",
    "offset": "$offset",
    "layer": 5,
    "controls": [
      {
        "button_panel": {
          "type": "panel",
          "size": "$button_size",
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "button_background": {
                "type": "image",
                "texture": "textures/ui/button_borderless_dark",
                "size": ["100%", "100%"],
                "layer": 1,
                "alpha": "$alpha"
              }
            },
            {
              "button_text": {
                "type": "label",
                "text": "#form_button_text",
                "font_type": "MinecraftTen",
                "font_size": "normal",
                "color": "white",
                "shadow": true,
                "anchor_from": "center",
                "anchor_to": "center",
                "layer": 3,
                "bindings": [
                  {
                    "binding_name": "#form_button_text",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "button_input@common_buttons.underline_button": {
          "$pressed_button_name": "button.form_button_click",
          "$button_text": "#null",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "size": "$button_size",
          "anchor_from": "center",
          "anchor_to": "center",
          "default_control": "default",
          "pressed_control": "hover",
          "hover_control": "hover",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ],
          "controls": [
            {
              "default@common.empty_panel": {}
            },
            {
              "hover@common.empty_panel": {
                "controls": [
                  {
                    "focus_border@common_buttons.focus_border": {
                      "size": ["100%", "100%"],
                      "layer": 2
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}