{
  "name": "mcbe-jsonui-ai-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic AI tool layer for Minecraft Bedrock JSON UI: IR + solver + compiler + validator on top of the mcbejsonuimasterAI knowledge base.",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "setup": "node tools/setup.mjs",
    "doctor": "node tools/doctor.mjs",
    "doctor:quick": "node tools/doctor.mjs --quick",
    "doctor:fix": "node tools/doctor.mjs --fix",
    "init": "node tools/init-project.mjs",
    "run": "node tools/run.mjs",
    "ir:validate": "node tools/ir-validate.mjs",
    "solve": "node tools/solve.mjs",
    "compile": "node tools/compile.mjs",
    "validate": "node tools/validate.mjs",
    "validate:pack": "node tools/validate-pack.mjs",
    "audit": "node tools/audit.mjs",
    "audit:public": "node tools/public-audit.mjs",
    "check": "node tools/audit.mjs && npm test",
    "build:vanilla-index": "node tools/build-vanilla-index.mjs",
    "source:scan": "node tools/source-scan.mjs",
    "catalog:build": "node tools/catalog-build.mjs",
    "design:search": "node tools/design-search.mjs",
    "asset:search": "node tools/asset-search.mjs",
    "preview": "node tools/preview.mjs",
    "validate:sources": "node tools/validate-sources.mjs",
    "eval:offline": "node tools/eval-offline.mjs",
    "eval:live": "node tools/eval-live.mjs",
    "tools:list": "node tools/tool-list.mjs",
    "tools:describe": "node tools/tool-describe.mjs",
    "skill:context": "node tools/skill-context.mjs",
    "skill:doctor": "node tools/skill-doctor.mjs",
    "prompt:build": "node tools/prompt-build.mjs",
    "prompt:lint": "node tools/prompt-lint.mjs",
    "render": "node tools/render.mjs",
    "diff": "node tools/diff.mjs",
    "test": "node tests/run-all.mjs && node tests/source-catalog.mjs && node tests/preview-engine.mjs && node tests/asset-search.mjs && node tests/ai-tool-contracts.mjs && node evals/validate-examples.mjs && node tests/offline-eval.mjs && node tests/public-audit.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.5.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.53",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0"
  }
}
